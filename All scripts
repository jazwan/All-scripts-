-- زري الانتقال للبرجين (Blue & Red Tower Transfer) مع نظام الحماية (Debounce)
-- ==========================================
local function createTowerTransferButtons(parent, x, y)
    local isTransferring = false

    -- دالة دوال الطيران الموحدة للبرجين
    local function getRoot()
        return localPlayer.Character and localPlayer.Character:FindFirstChild("HumanoidRootPart")
    end

    local function slowFlyTo(targetCFrame, duration)
        local rootPart = getRoot()
        if not rootPart then return end
        
        local bv = rootPart:FindFirstChild("FlyBV")
        if not bv then
            bv = Instance.new("BodyVelocity")
            bv.Name = "FlyBV"
            bv.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
            bv.Velocity = Vector3.new(0, 0, 0)
            bv.Parent = rootPart
        end
        
        local targetPos = targetCFrame + Vector3.new(0, 3, 0)
        local tweenInfo = TweenInfo.new(duration, Enum.EasingStyle.Linear)
        local tween = TweenService:Create(rootPart, tweenInfo, {CFrame = targetPos})
        
        tween:Play()
        tween.Completed:Wait()
    end

    local function stopFlying()
        local rootPart = getRoot()
        if rootPart then
            local bv = rootPart:FindFirstChild("FlyBV")
            if bv then bv:Destroy() end
        end
    end

    -- زر الأزرق (Blue Tower Transfer)
    local btnBlue = Instance.new("TextButton", parent)
    btnBlue.BackgroundColor3 = Color3.fromRGB(230, 230, 230)
    btnBlue.Position = UDim2.new(0, x, 0, y)
    btnBlue.Size = UDim2.new(0, 180, 0, 35)
    btnBlue.Font = Enum.Font.GothamBold
    btnBlue.Text = "Blue Tower"
    btnBlue.TextColor3 = Color3.fromRGB(0, 0, 0)
    btnBlue.TextSize = 14
    btnBlue.ZIndex = 1
    Instance.new("UICorner", btnBlue).CornerRadius = UDim.new(0, 4)

    local IndicatorBlue = Instance.new("ImageLabel", btnBlue)  
    IndicatorBlue.BackgroundTransparency = 1  
    IndicatorBlue.Position = UDim2.new(0, 8, 0.5, -6)   
    IndicatorBlue.Size = UDim2.new(0, 12, 0, 12)  
    IndicatorBlue.Image = "rbxassetid://3926305904"   
    IndicatorBlue.ImageColor3 = Color3.fromRGB(255, 50, 50)   
    IndicatorBlue.ZIndex = 2

    -- زر الأحمر (Red Tower Transfer)
    local btnRed = Instance.new("TextButton", parent)
    btnRed.BackgroundColor3 = Color3.fromRGB(230, 230, 230)
    btnRed.Position = UDim2.new(0, x + 190, 0, y)
    btnRed.Size = UDim2.new(0, 185, 0, 35)
    btnRed.Font = Enum.Font.GothamBold
    btnRed.Text = "Red Tower"
    btnRed.TextColor3 = Color3.fromRGB(0, 0, 0)
    btnRed.TextSize = 14
    btnRed.ZIndex = 1
    Instance.new("UICorner", btnRed).CornerRadius = UDim.new(0, 4)

    local IndicatorRed = Instance.new("ImageLabel", btnRed)  
    IndicatorRed.BackgroundTransparency = 1  
    IndicatorRed.Position = UDim2.new(0, 8, 0.5, -6)   
    IndicatorRed.Size = UDim2.new(0, 12, 0, 12)  
    IndicatorRed.Image = "rbxassetid://3926305904"   
    IndicatorRed.ImageColor3 = Color3.fromRGB(255, 50, 50)   
    IndicatorRed.ZIndex = 2

    -- تنفيذ الانتقال للبرج الأزرق
    btnBlue.MouseButton1Click:Connect(function()
        if isTransferring then return end
        isTransferring = true
        safePlaySound()

        IndicatorBlue.ImageColor3 = Color3.fromRGB(50, 255, 50)
        IndicatorRed.ImageColor3 = Color3.fromRGB(255, 50, 50)

        showMadaWelcomeLogo()

        task.spawn(function()
            local rootPart = getRoot()
            if rootPart then
                local blackBlock = Workspace:FindFirstChild("SpawnLocation")
                local map = Workspace:FindFirstChild("Map")
                local blueTower = map and map:FindFirstChild("Blue") and map.Blue:FindFirstChild("Tower") and map.Blue.Tower:FindFirstChild("Part")
                
                local blueFolder = map and map:FindFirstChild("Blue")
                local blueLadderModel = blueFolder and blueFolder:FindFirstChild("Hole") and blueFolder.Hole:FindFirstChild("Ladder")
                local blueLadderPart = blueLadderModel and (blueLadderModel:FindFirstChild("Smooth Block Model") or blueLadderModel:FindFirstChildWhichIsA("BasePart"))

                local myTeam = localPlayer.Team and localPlayer.Team.Name or ""
                
                if string.match(string.lower(myTeam), "blue") then
                    if blueTower then
                        slowFlyTo(blueTower.CFrame, 1.5)
                    end
                    stopFlying()
                else
                    if blackBlock then
                        slowFlyTo(blackBlock.CFrame, 4)
                        task.wait(5)
                    end
                    
                    if blueLadderPart then
                        local stepOffset = Vector3.new(0, -1, 2)
                        local targetLadderCFrame = CFrame.new(blueLadderPart.Position + stepOffset)
                        slowFlyTo(targetLadderCFrame, 6)
                    end
                    
                    if blueTower then
                        slowFlyTo(blueTower.CFrame, 5)
                    end
                    
                    stopFlying()
                end
            end

            -- إعادة تفعيل الأزرار بعد انتهاء الرحلة بالكامل
            isTransferring = false
            IndicatorBlue.ImageColor3 = Color3.fromRGB(255, 50, 50)
        end)
    end)

    -- تنفيذ الانتقال للبرج الأحمر
    btnRed.MouseButton1Click:Connect(function()
        if isTransferring then return end
        isTransferring = true
        safePlaySound()

        IndicatorRed.ImageColor3 = Color3.fromRGB(50, 255, 50)
        IndicatorBlue.ImageColor3 = Color3.fromRGB(255, 50, 50)

        showMadaWelcomeLogo()

        task.spawn(function()
            local rootPart = getRoot()
            if rootPart then
                local blackBlock = Workspace:FindFirstChild("SpawnLocation")
                local redTower = Workspace:FindFirstChild("Map") and Workspace.Map:FindFirstChild("Red") and Workspace.Map.Red:FindFirstChild("Tower") and Workspace.Map.Red.Tower:FindFirstChild("Part")

                local map = Workspace:FindFirstChild("Map")
                local redFolder = map and map:FindFirstChild("Red")
                local redLadderModel = redFolder and redFolder:FindFirstChild("Hole") and redFolder.Hole:FindFirstChild("Ladder")
                
                local point_RedLadderBottom = nil
                local point_RedLadderTop = nil
                
                if redLadderModel then
                    local redLadderPart = redLadderModel:FindFirstChild("Smooth Block Model") or redLadderModel:FindFirstChildWhichIsA("BasePart")
                    if redLadderPart then
                        local stepOffset = Vector3.new(0, -1, 2)
                        point_RedLadderBottom = CFrame.new(redLadderPart.Position + stepOffset)
                        
                        local topY = -math.huge
                        local topPart = nil
                        for _, part in ipairs(redLadderModel:GetDescendants()) do
                            if part:IsA("BasePart") and part.Position.Y > topY then
                                topY = part.Position.Y
                                topPart = part
                            end
                        end
                        if topPart then
                            point_RedLadderTop = CFrame.new(topPart.Position + Vector3.new(0, 1, 2))
                        else
                            point_RedLadderTop = redLadderModel:GetPivot()
                        end
                    end
                end

                local myTeam = localPlayer.Team and localPlayer.Team.Name or ""
                
                if string.match(string.lower(myTeam), "red") then
                    if redTower then
                        slowFlyTo(redTower.CFrame, 2)
                    end
                    stopFlying()
                else
                    if blackBlock then
                        slowFlyTo(blackBlock.CFrame, 4)
                        task.wait(5)
                    end
                    
                    if point_RedLadderBottom then
                        slowFlyTo(point_RedLadderBottom, 6)
                        if point_RedLadderTop then
                            slowFlyTo(point_RedLadderTop, 0.5)
                        end
                    end
                    
                    if redTower then
                        slowFlyTo(redTower.CFrame, 5)
                    end
                    
                    stopFlying()
                end
            end

            -- إعادة تفعيل الأزرار بعد انتهاء الرحلة بالكامل
            isTransferring = false
            IndicatorRed.ImageColor3 = Color3.fromRGB(255, 50, 50)
        end)
    end)
end

