        end  
    end)  

    local function isBlockedByGrass(myPos, targetPos, myChar, targetChar)
        local raycastParams = RaycastParams.new()
        if Enum and Enum.RaycastFilterType and Enum.RaycastFilterType.Exclude then
            raycastParams.FilterType = Enum.RaycastFilterType.Exclude
        else
            raycastParams.FilterType = Enum.RaycastFilterType.Blacklist
        end
        raycastParams.FilterDescendantsInstances = {myChar, targetChar}
        raycastParams.IgnoreWater = true

        local direction = targetPos - myPos
        local result = Workspace:Raycast(myPos, direction, raycastParams)

        if result and result.Instance then
            return true 
        end
        return false 
    end

    local function getNearestTarget()
        local nearestDistance = activationDistance
        local nearestChar = nil
        local character = localPlayer.Character
        
        if character and character:FindFirstChild("HumanoidRootPart") then
            local myPos = character.HumanoidRootPart.Position
            for _, player in ipairs(Players:GetPlayers()) do
                local isEnemy = (player ~= localPlayer) and (not localPlayer.Team or player.Team ~= localPlayer.Team)
                if isEnemy then
                    local targetChar = player.Character
                    if targetChar then
                        local targetHRP = targetChar:FindFirstChild("HumanoidRootPart")
                        local targetHum = targetChar:FindFirstChild("Humanoid")
                        if targetHRP and targetHum and targetHum.Health > 0 then
                            local distance = (targetHRP.Position - myPos).Magnitude
                            if distance < nearestDistance then
                                if not isBlockedByGrass(myPos, targetHRP.Position, character, targetChar) then
                                    nearestDistance = distance
                                    nearestChar = targetChar
                                end
                            end
                        end
                    end
                end
            end
        end
        return nearestChar
    end

    btn.MouseButton1Click:Connect(function()
        safePlaySound()
        teleportToggled = not teleportToggled
        if teleportToggled then
            Indicator.ImageColor3 = Color3.fromRGB(50, 255, 50)
            showMadaWelcomeLogo()
        else
            Indicator.ImageColor3 = Color3.fromRGB(255, 50, 50)
        end
    end)

    RunService.RenderStepped:Connect(function()
        if not teleportToggled then return end
        
        local character = localPlayer.Character
        if not character then return end
        
        local myHRP = character:FindFirstChild("HumanoidRootPart")
        local myHumanoid = character:FindFirstChildOfClass("Humanoid")
        
        if not myHumanoid or myHumanoid.Health <= 0 or not myHRP then return end
        
        local targetChar = getNearestTarget()
        if targetChar then
            local targetHRP = targetChar:FindFirstChild("HumanoidRootPart")
            if targetHRP then
                local angle = os.clock() * orbitSpeed
                local offsetX = math.cos(angle) * orbitRadius
                local offsetZ = math.sin(angle) * orbitRadius
                local targetPosition = targetHRP.Position + Vector3.new(offsetX, 0, offsetZ)
                myHRP.CFrame = CFrame.new(targetPosition, targetHRP.Position)
            end
        end
    end)
end

