-- 3. نظام الـ ESP (مدمج لمنع الاختفاء + شفافية ديناميكية)
-- ==========================================
local ESP_Objects = {}

local function createESP(player)
    if player == LocalPlayer then return end
    
    -- الإضاءة للمسافات القريبة
    local hl = Instance.new("Highlight")
    hl.Name = player.Name .. "_HL"
    hl.FillColor = Color3.fromRGB(255, 0, 0)
    hl.OutlineColor = Color3.fromRGB(255, 255, 255)
    hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop 
    hl.Enabled = false
    hl.Parent = SafeGui

    -- الصندوق للمسافات البعيدة (لكي لا يختفي أبداً)
    local box = Instance.new("BoxHandleAdornment")
    box.Name = player.Name .. "_BOX"
    box.Size = Vector3.new(4, 5.5, 2)
    box.Color3 = Color3.fromRGB(255, 0, 0)
    box.AlwaysOnTop = true
    box.ZIndex = 10
    box.Visible = false
    box.Parent = SafeGui

    ESP_Objects[player] = {Highlight = hl, Box = box}
end

for _, p in ipairs(Players:GetPlayers()) do createESP(p) end
Players.PlayerAdded:Connect(createESP)
Players.PlayerRemoving:Connect(function(p)
    if ESP_Objects[p] then 
        ESP_Objects[p].Highlight:Destroy()
        ESP_Objects[p].Box:Destroy()
        ESP_Objects[p] = nil 
    end
end)

RunService.RenderStepped:Connect(function()
    local nearest, dist = nil, math.huge
    local myRoot = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")

    for player, obj in pairs(ESP_Objects) do
        local isEnemy = true
        if LocalPlayer.Team and player.Team and LocalPlayer.Team == player.Team then
            isEnemy = false
        end

        if isEnemy and player.Character and player.Character:FindFirstChild("HumanoidRootPart") and player.Character:FindFirstChild("Humanoid") and player.Character.Humanoid.Health > 0 then
            local enemyRoot = player.Character.HumanoidRootPart
            local d = 0
            
            if myRoot then
                d = (myRoot.Position - enemyRoot.Position).Magnitude
                if d < dist then 
                    dist = d
                    nearest = player 
                end
            end

            -- حساب الشفافية: قريب = 0.2 (واضح جداً)، بعيد = 0.8 (عميق وخفيف)
            local dynamicTransparency = math.clamp(d / 400, 0.2, 0.8)

            if d < 150 then
                -- إذا كان قريباً، نستخدم الـ Highlight للوضوح
                obj.Highlight.Adornee = player.Character
                obj.Highlight.FillTransparency = dynamicTransparency
                obj.Highlight.Enabled = true
                obj.Box.Visible = false
            else
                -- إذا كان بعيداً جداً، نستخدم الـ Box لكي لا يختفي بسبب المحرك
                obj.Box.Adornee = enemyRoot
                obj.Box.Transparency = dynamicTransparency
                obj.Box.Visible = true
                obj.Highlight.Enabled = false
            end
        else
            obj.Highlight.Enabled = false
            obj.Box.Visible = false
        end
    end

    -- عرض إشعار أقرب لاعب
    if nearest then
        NotifFrame.Visible = true
        NameText.Text = nearest.Name
        pcall(function()
            local content = Players:GetUserThumbnailAsync(nearest.UserId, Enum.ThumbnailType.HeadShot, Enum.ThumbnailSize.Size150x150)
            PlayerIcon.Image = content
        end)
    else
        NotifFrame.Visible = false
    end
end)
