-- 🚀 قسم سكربت الحركة الخاص بك
---------------------------------------------------------
local function getRoot()
    return player.Character and player.Character:FindFirstChild("HumanoidRootPart")
end

local function slowFlyTo(targetCFrame, duration)
    local rootPart = getRoot()
    if not rootPart then return end
    
    local bv = rootPart:FindFirstChild("FlyBV")
    if not bv then
        bv = Instance.new("BodyVelocity")
        bv.Name = "FlyBV"
        bv.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
        bv.Velocity = Vector3.new(0, 0, 0)
        bv.Parent = rootPart
    end
    
    local targetPos = targetCFrame + Vector3.new(0, 3, 0)
    local tweenInfo = TweenInfo.new(duration, Enum.EasingStyle.Linear)
    local tween = TweenService:Create(rootPart, tweenInfo, {CFrame = targetPos})
    
    tween:Play()
    tween.Completed:Wait()
end

local function stopFlying()
    local rootPart = getRoot()
    if rootPart then
        local bv = rootPart:FindFirstChild("FlyBV")
        if bv then bv:Destroy() end
    end
end

local function goToRedTowerSmooth()
    local rootPart = getRoot()
    if not rootPart then return end

    local blackBlock = workspace:FindFirstChild("SpawnLocation")
    local redTower = workspace.Map.Red.Tower.Part
    local redLadder = workspace.Map.Red.Hole.Ladder["Smooth Block Model"]

    local myTeam = player.Team and player.Team.Name or ""
    
    if string.match(string.lower(myTeam), "red") then
        slowFlyTo(redTower.CFrame, 2)
        stopFlying()
    else
        if blackBlock then
            slowFlyTo(blackBlock.CFrame, 4)
            task.wait(5)
        end
        
        if redLadder then
            slowFlyTo(redLadder.CFrame, 6)
            local climbPos = redLadder.CFrame + Vector3.new(0, 20, 0)
            slowFlyTo(climbPos, 0.5)
        end
        
        if redTower then
            slowFlyTo(redTower.CFrame, 5)
        end
        
        stopFlying()
    end
end

goToRedTowerSmooth()
