local uiVisible = true
local isAnimating = false
local function ToggleUI()
    if isAnimating then return end
    isAnimating = true
    safePlaySound()
    if not uiVisible then
        MainFrame.Visible = true
        MainFrame.Size = UDim2.new(0, 450, 0, 270)
        MainFrame.BackgroundTransparency = 1
        MainStroke.Transparency = 1
        local openTween = TweenService:Create(MainFrame, TweenInfo.new(0.3, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {
            Size = UDim2.new(0, 560, 0, 340),
            BackgroundTransparency = 0
        })
        TweenService:Create(MainStroke, TweenInfo.new(0.3), {Transparency = 0}):Play()
        openTween:Play()
        openTween.Completed:Wait()
        uiVisible = true
    else
        local closeTween = TweenService:Create(MainFrame, TweenInfo.new(0.2, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {
            Size = UDim2.new(0, 450, 0, 270),
            BackgroundTransparency = 1
        })
        TweenService:Create(MainStroke, TweenInfo.new(0.2), {Transparency = 1}):Play()
        closeTween:Play()
        closeTween.Completed:Wait()
        MainFrame.Visible = false
        uiVisible = false
    end
    isAnimating = false
end

