    local toggledAimbot = false  
    local aimbotConnection = nil
    local aimbotGui = nil

    btnAimbot.MouseButton1Click:Connect(function()  
        safePlaySound()  
        toggledAimbot = not toggledAimbot  
        if toggledAimbot then 
            IndicatorAimbot.ImageColor3 = Color3.fromRGB(50, 255, 50) 
            
            local ReplicatedStorage = game:GetService("ReplicatedStorage")
            local RemoteEvent = ReplicatedStorage.Events.Remote.ShotTarget
            local SoundService = game:GetService("SoundService")
            local workspace = game:GetService("Workspace")

            local targetTeamName = "Red"  
            local cooldown = 0  
            local bulletSpeed = 49.5  
            local minPredictionDistance = 0  
            local maxPredictionDistance = 10  
            local lastShotTime = 0  

            local function getTargetTeam()
                if localPlayer.Team then
                    if localPlayer.Team.Name == "Red" then
                        return "Blue"
                    elseif localPlayer.Team.Name == "Blue" then
                        return "Red"
                    end
                end
                return targetTeamName
            end

            local function playAimbotSound(soundId, delay)
                delay = delay or 0
                local sound = Instance.new("Sound")
                sound.SoundId = "rbxassetid://" .. soundId
                sound.Parent = SoundService
                sound:Play()
                task.wait(delay)
                pcall(function() sound:Destroy() end)
            end

            task.spawn(function()
                if not toggledAimbot then return end
                playAimbotSound(2865227271, 0.5)
                task.wait(0.5)
                if toggledAimbot then playAimbotSound(1676318332) end
            end)

            local function findClosestPlayer()
                local players = Players:GetPlayers()
                local closestPlayer = nil
                local shortestDistance = math.huge
                
                local char = localPlayer.Character
                if not char then return nil, math.huge end
                local tool = char:FindFirstChildOfClass("Tool")
                local head = char:FindFirstChild("Head")
                
                if tool and head then
                    local camera = workspace.CurrentCamera
                    local shooterPosition = head.CFrame.Position + (camera.CFrame.LookVector * 1.5)
                    local currentTargetTeam = getTargetTeam()
                    
                    for _, plyr in ipairs(players) do
                        if plyr ~= localPlayer and plyr.Team and plyr.Team.Name == currentTargetTeam and plyr.Character and plyr.Character:FindFirstChild("Humanoid") and plyr.Character.Humanoid.Health > 0 then
                            local targetPosition = plyr.Character.HumanoidRootPart.Position
                            
                            local raycastParams = RaycastParams.new()
                            raycastParams.FilterType = Enum.RaycastFilterType.Blacklist
                            raycastParams.FilterDescendantsInstances = {char}
                            local rayResult = workspace:Raycast(shooterPosition, targetPosition - shooterPosition, raycastParams)
                            
                            local isVisible = false
                            if rayResult and rayResult.Instance:IsDescendantOf(plyr.Character) then
                                isVisible = true
                            elseif not rayResult then
                                isVisible = true
                            end
                            
                            if isVisible then
                                local horizontalDistance = (Vector3.new(targetPosition.X, 0, targetPosition.Z) - Vector3.new(shooterPosition.X, 0, shooterPosition.Z)).magnitude
                                local heightDifference = math.abs(targetPosition.Y - shooterPosition.Y)
                                local totalDistance = (horizontalDistance^2 + heightDifference^2)^0.5
                                
                                if totalDistance < shortestDistance then
                                    closestPlayer = plyr
                                    shortestDistance = totalDistance
                                end
                            end
                        end
                    end
                end
                
                return closestPlayer, shortestDistance
            end

            local function predictPosition(targetPosition, targetVelocity)
                local char = localPlayer.Character
                if not char then return targetPosition end
                local head = char:FindFirstChild("Head")
                local camera = workspace.CurrentCamera
                
                local shooterPosition = head and (head.CFrame.Position + (camera.CFrame.LookVector * 1.5)) or char.HumanoidRootPart.Position
                local distanceToTarget = (targetPosition - shooterPosition).magnitude
                
                local predictionDistance = math.clamp(distanceToTarget, minPredictionDistance, maxPredictionDistance)
                local timeToImpact = predictionDistance / bulletSpeed
                
                return targetPosition + targetVelocity * timeToImpact
            end

            local function fireRemoteEvent(targetPlayer)
                if targetPlayer then
                    local currentTime = os.time()
                    if currentTime - lastShotTime >= cooldown then
                        local targetPosition = targetPlayer.Character.HumanoidRootPart.Position
                        local targetVelocity = targetPlayer.Character.HumanoidRootPart.Velocity
                        local predictedPosition = predictPosition(targetPosition, targetVelocity)
                        
                        local args = {
                            [1] = predictedPosition,
                            [2] = "Sniper"
                        }
